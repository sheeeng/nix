#!/usr/bin/env python3
"""Update the hash for a fetchFromGitHub block after Renovate bumps its rev.

Usage: renovate-update-nix-hash <owner/repo> <new-version> <package-file>

Renovate postUpgradeTasks calls this script with Mustache template variables
substituted for each bumped dependency. The script fetches the correct Nix
hash via nix-prefetch-github and rewrites the hash field in the Nix file.
"""

import json
import re
import subprocess
import sys


def fetch_hash(owner: str, repo: str, rev: str) -> tuple[str, str]:
    result = subprocess.run(
        ["nix", "run", "nixpkgs#nix-prefetch-github", "--", owner, repo, "--rev", rev],
        capture_output=True,
        text=True,
        check=True,
    )
    data = json.loads(result.stdout)
    return data["hash"], data["rev"]


def update_hash(content: str, owner: str, repo: str, new_hash: str, new_rev: str) -> str:
    def replace_block(match: re.Match) -> str:
        block = match.group(0)
        has_owner = f'owner = "{owner}"' in block
        has_repo = f'repo = "{repo}"' in block
        if not (has_owner and has_repo):
            return block
        updated = re.sub(r'(hash\s*=\s*)"[^"]*"', f'\\1"{new_hash}"', block)
        updated = re.sub(
            r'(rev\s*=\s*"[^"]*";\s*)#\s*[0-9a-f]{40}',
            f'\\1# {new_rev}',
            updated,
        )
        return updated

    return re.sub(
        r'fetchFromGitHub\s*\{[^{}]*\}',
        replace_block,
        content,
        flags=re.DOTALL,
    )


def main() -> None:
    if len(sys.argv) != 4:
        print(f"Usage: {sys.argv[0]} <owner/repo> <new-version> <package-file>", file=sys.stderr)
        sys.exit(1)

    dep_name, new_version, package_file = sys.argv[1], sys.argv[2], sys.argv[3]

    parts = dep_name.split("/", 1)
    if len(parts) != 2:
        print(f"Invalid dep name (expected owner/repo): {dep_name}", file=sys.stderr)
        sys.exit(1)
    owner, repo = parts

    new_hash, new_rev = fetch_hash(owner, repo, new_version)

    with open(package_file) as f:
        content = f.read()

    new_content = update_hash(content, owner, repo, new_hash, new_rev)

    if new_content == content:
        print(f"No hash field found for {owner}/{repo} in {package_file}", file=sys.stderr)
        sys.exit(1)

    with open(package_file, "w") as f:
        f.write(new_content)

    print(f"Updated {owner}/{repo}@{new_version}: hash={new_hash}")


if __name__ == "__main__":
    main()
