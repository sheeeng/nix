# SketchyBar for AeroSpace. default.nix sets the workspaces variable above this file. The
# aerospace_workspace_change event comes from exec-on-workspace-change and after-startup-command in
# default.nix. https://felixkratz.github.io/SketchyBar/config/events

sketchybar --bar position=top height=32 padding_left=8 padding_right=8

sketchybar --default \
  icon.color=0xffffffff \
  label.color=0xffffffff \
  label.padding_left=6 \
  label.padding_right=6

sketchybar --add event aerospace_workspace_change

for workspace in $workspaces; do
  sketchybar --add item "space.${workspace}" left \
    --subscribe "space.${workspace}" aerospace_workspace_change \
    --set "space.${workspace}" \
    background.color=0x44ffffff \
    background.corner_radius=5 \
    background.drawing=off \
    background.height=20 \
    click_script="aerospace workspace ${workspace}" \
    label="${workspace}" \
    script="[ \"\$FOCUSED_WORKSPACE\" = \"${workspace}\" ] && sketchybar --set \$NAME background.drawing=on || sketchybar --set \$NAME background.drawing=off"
done

sketchybar --add item clock right \
  --set clock \
  script="sketchybar --set \$NAME label=\"\$(date '+%a %Y-%m-%d %H:%M')\"" \
  update_freq=10

sketchybar --update

# The update above runs the item scripts without FOCUSED_WORKSPACE, which clears every highlight. Mark the
# focused workspace again. If AeroSpace is not running yet, its after-startup-command does it later.
focused_workspace="$(aerospace list-workspaces --focused 2>/dev/null)"
if [ -n "${focused_workspace}" ]; then
  sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE="${focused_workspace}"
fi
