{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":disableDependencyDashboard"
  ],
  "rebaseWhen": "behind-base-branch",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "at any time"
    ],
    "description": "https://docs.renovatebot.com/configuration-options/#lockfilemaintenance"
  },
  "nix": {
    "enabled": true,
    "description": "https://docs.renovatebot.com/modules/manager/nix/#enabling"
  },
  "pre-commit": {
    "enabled": true,
    "description": "https://docs.renovatebot.com/modules/manager/pre-commit/#enabling"
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.nix$/"
      ],
      "matchStrings": [
        "fetchFromGitHub\\s*\\{[^}]*owner\\s*=\\s*\"(?<depName>[^\"]+)\"[^}]*repo\\s*=\\s*\"(?<packageName>[^\"]+)\"[^}]*rev\\s*=\\s*\"(?<currentValue>v?[0-9]+\\.[0-9]+[^\"]*)\"",
        "fetchFromGitHub\\s*\\{[^}]*repo\\s*=\\s*\"(?<packageName>[^\"]+)\"[^}]*owner\\s*=\\s*\"(?<depName>[^\"]+)\"[^}]*rev\\s*=\\s*\"(?<currentValue>v?[0-9]+\\.[0-9]+[^\"]*)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "{{{depName}}}/{{{packageName}}}",
      "packageNameTemplate": "{{{depName}}}/{{{packageName}}}",
      "extractVersionTemplate": "^(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "terraform-version"
      ],
      "description": "Update Terraform through the scheduled binary updater.",
      "enabled": false
    },
    {
      "matchDatasources": [
        "git-refs"
      ],
      "matchManagers": [
        "nix"
      ],
      "matchPackageNames": [
        "https://flakehub.com/f/DeterminateSystems/determinate/3",
        "https://flakehub.com/f/hercules-ci/flake-parts/0.1"
      ],
      "description": "Ignore FlakeHub tarball inputs that the git-refs datasource cannot resolve.",
      "enabled": false
    },
    {
      "matchFileNames": [
        "**/*.nix"
      ],
      "matchManagers": [
        "custom.regex"
      ],
      "description": "Update Nix fetchFromGitHub revisions.",
      "enabled": true,
      "postUpgradeTasks": {
        "commands": [
          "python3 scripts/renovate-update-nix-hash {{{depName}}} {{{newVersion}}} {{{packageFile}}}"
        ],
        "fileFilters": [
          "**/*.nix"
        ],
        "executionMode": "update"
      }
    },
    {
      "matchManagers": [
        "nix"
      ],
      "description": "Group nix flake input updates together.",
      "groupName": "nix flake inputs",
      "schedule": [
        "at any time"
      ],
      "labels": [
        "dependencies",
        "nix"
      ]
    },
    {
      "matchManagers": [
        "pre-commit"
      ],
      "description": "Group pre-commit hook updates together.",
      "groupName": "pre-commit hooks",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "schedule": [
        "at any time"
      ],
      "labels": [
        "dependencies",
        "pre-commit"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "description": "Ignore GitHub Actions dependencies as they are handled by Dependabot.",
      "enabled": false
    }
  ]
}
