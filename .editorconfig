
# EditorConfig is awesome: https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[{.,}*.{js{,*}}]
indent_size = 2
indent_style = space

[*.{yaml,yml}]
indent_size = 2
indent_style = space
insert_final_newline = false
trim_trailing_whitespace = false

[*.{md,txt}]
indent_size = 4
indent_style = space
max_line_length = 72
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.nu]
indent_size = 4
indent_style = space

# Follow https://google.github.io/styleguide/shellguide.html guide.
# shfmt -i 2 -ci -bn
# https://github.com/mvdan/sh/blob/master/cmd/shfmt/shfmt.1.scd
[*.sh]
binary_next_line = true
function_next_line = false
indent_size = 2
indent_style = space
keep_padding = true
minify = false
shell_variant = bash
simplify = true
space_redirects = true
switch_case_indent = true
